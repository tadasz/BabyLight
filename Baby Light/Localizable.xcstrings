{
  "sourceLanguage": "en",
  "strings": {
    "Learned from your last %lld nights — glows about %lld min after you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلَّم من آخر %lld ليالٍ لديك — يضيء بعد نحو %lld دقيقة من فتحك للتطبيق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lært af dine seneste %lld nætter — lyser ca. %lld min efter du åbner appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen letzten %lld Nächten gelernt — leuchtet etwa %lld Min. nach dem Öffnen der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έμαθε από τις τελευταίες %lld νύχτες σου — ανάβει περίπου %lld λεπτά αφότου ανοίξεις την εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido de tus últimas %lld noches: brilla unos %lld min después de abrir la app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido de tus últimas %lld noches: brilla unos %lld min después de abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opittu viimeisistä %lld yöstäsi — hehkuu noin %lld min sovelluksen avaamisen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appris de vos %lld dernières nuits — s'allume environ %lld min après l'ouverture de l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पिछली %lld रातों से सीखा — ऐप खोलने के लगभग %lld मिनट बाद चमकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipelajari dari %lld malam terakhir Anda — menyala sekitar %lld mnt setelah Anda membuka aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appreso dalle tue ultime %lld notti — si illumina circa %lld min dopo l'apertura dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の%lld晩から学習 — アプリを開いてから約%lld分後に光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %lld일 밤에서 학습 — 앱을 연 뒤 약 %lld분 후에 빛납니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išmokta iš paskutinių %lld naktų — švyti maždaug po %lld min. atidarius programą."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lært av dine siste %lld netter — lyser ca. %lld min etter at du åpner appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleerd van je laatste %lld nachten — gloeit ongeveer %lld min nadat je de app opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauczono z ostatnich %lld nocy — świeci około %lld min po otwarciu aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido nas suas últimas %lld noites — brilha cerca de %lld min depois de você abrir o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучено по последним %lld ночам — светится примерно через %lld мин после открытия приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lärt från dina senaste %lld nätter — lyser cirka %lld min efter att du öppnar appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียนรู้จาก %lld คืนล่าสุดของคุณ — เรืองแสงประมาณ %lld นาทีหลังจากคุณเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %lld gecenizden öğrenildi — uygulamayı açtıktan yaklaşık %lld dk sonra parlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчено за останні %lld ночей — світиться приблизно через %lld хв після відкриття застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Học từ %lld đêm gần nhất của bạn — phát sáng khoảng %lld phút sau khi bạn mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你最近的 %lld 晚学习——在你打开应用约 %lld 分钟后发光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你最近的 %lld 晚學習——在你開啟應用程式約 %lld 分鐘後發光。"
          }
        }
      }
    },
