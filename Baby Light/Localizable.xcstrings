    "A gentle glow suggests a good moment to try the put-down.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的微光提示：现在是尝试放下宝宝的好时机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的微光提示：現在是嘗試放下寶寶的好時機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしい光は、寝かしつけを試す良いタイミングの合図です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은은한 빛은 아기를 눕히기 좋은 순간을 알려줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое свечение подсказывает удачный момент переложить малыша."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Leuchten zeigt einen guten Moment zum Ablegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une douce lueur suggère un bon moment pour poser bébé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brillo suave sugiere un buen momento para acostarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brillo suave sugiere un buen momento para acostarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bagliore delicato suggerisce un buon momento per metterlo giù."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um brilho suave sugere um bom momento para deitar o bebê."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte gloed wijst op een goed moment om baby neer te leggen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak bir parıltı, bebeği yatırmayı denemek için iyi bir anı gösterir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatna poświata podpowiada dobry moment na odłożenie malucha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توهّج لطيف يشير إلى لحظة مناسبة لمحاولة وضع الطفل في سريره."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्की चमक बताती है कि शिशु को लिटाने का यह अच्छा समय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaran lembut menandakan saat yang tepat untuk membaringkan bayi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสงเรืองอ่อน ๆ บอกช่วงเวลาที่เหมาะจะลองวางลูกน้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh sáng dịu nhẹ gợi ý thời điểm tốt để thử đặt bé xuống."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mjuk glöd visar ett bra tillfälle att lägga ner barnet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blid glød viser et godt tidspunkt at lægge baby ned."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En myk glød viser et godt øyeblikk å legge babyen ned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pehmeä hehku kertoo hyvästä hetkestä laskea vauva sänkyyn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια απαλή λάμψη δείχνει μια καλή στιγμή να ακουμπήσετε το μωρό."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "М’яке світіння підказує вдалий момент перекласти малюка."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Švelnus švytėjimas parodo tinkamą akimirką paguldyti mažylį."
