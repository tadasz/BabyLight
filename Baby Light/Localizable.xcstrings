    "Double-tap anywhere to hide these controls and dim the screen to a calm night light.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击屏幕任意处可隐藏控制项，并将屏幕调暗为柔和的夜灯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙擊螢幕任一處可隱藏控制項，並將螢幕調暗為柔和的夜燈。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のどこでもダブルタップで操作パネルを隠し、画面を落ち着いた常夜灯の明るさにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아무 곳이나 두 번 탭하면 컨트롤이 숨겨지고 화면이 은은한 수면등으로 어두워집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснитесь в любом месте, чтобы скрыть управление и приглушить экран до спокойного ночника."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippe irgendwo, um diese Steuerung auszublenden und den Bildschirm zu einem ruhigen Nachtlicht zu dimmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois n'importe où pour masquer ces commandes et tamiser l'écran en une veilleuse apaisante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces en cualquier lugar para ocultar estos controles y atenuar la pantalla como una luz nocturna suave."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces en cualquier lugar para ocultar estos controles y atenuar la pantalla como una luz nocturna suave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte un punto qualsiasi per nascondere questi controlli e attenuare lo schermo come una luce notturna delicata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes em qualquer lugar para ocultar estes controles e escurecer a tela como uma luz noturna suave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik ergens om deze bediening te verbergen en het scherm te dimmen tot een rustig nachtlampje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kontrolleri gizlemek ve ekranı sakin bir gece lambasına kısmak için herhangi bir yere çift dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie w dowolnym miejscu, aby ukryć te elementy sterujące i przyciemnić ekran do spokojnej lampki nocnej."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرتين في أي مكان لإخفاء عناصر التحكم هذه وخفض إضاءة الشاشة إلى ضوء ليلي هادئ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन नियंत्रणों को छिपाने और स्क्रीन को एक शांत नाइट लाइट तक मद्धम करने के लिए कहीं भी दो बार टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali di mana saja untuk menyembunyikan kontrol ini dan meredupkan layar menjadi lampu tidur yang tenang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งที่ใดก็ได้เพื่อซ่อนตัวควบคุมเหล่านี้และหรี่หน้าจอให้เป็นไฟกลางคืนที่นุ่มนวล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hai lần vào bất kỳ đâu để ẩn các điều khiển này và làm mờ màn hình thành đèn ngủ dịu nhẹ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltryck var som helst för att dölja reglagen och dämpa skärmen till ett lugnt nattljus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttryk hvor som helst for at skjule disse kontroller og dæmpe skærmen til et roligt natlys."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk hvor som helst for å skjule disse kontrollene og dempe skjermen til et rolig nattlys."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksoisnapauta missä tahansa piilottaaksesi nämä säätimet ja himmentääksesi näytön rauhalliseksi yövaloksi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε δύο φορές οπουδήποτε για να αποκρύψετε αυτά τα στοιχεία ελέγχου και να χαμηλώσετε την οθόνη σε ένα ήρεμο νυχτερινό φως."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться двічі будь-де, щоб приховати ці елементи керування й приглушити екран до спокійного нічника."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite du kartus bet kur, kad paslėptumėte šiuos valdiklius ir pritemdytumėte ekraną iki ramios naktinės lemputės."
          }
        }
      }
    },
